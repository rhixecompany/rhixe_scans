generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comic {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String   @unique(map: "comic_title_idx")
  slug          String   @unique(map: "comic_slug_idx")
  description   String
  status        String
  rating        Decimal  @default(0) @db.Decimal(10, 1)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt
  updated_at    DateTime @db.Timestamp(6)
  link          String
  serialization String?
  numchapters   Int      @default(0)
  numimages     Int      @default(0)
  has_chapters  Boolean  @default(false)
  has_images    Boolean  @default(false)
  category      Json     @db.Json
  author        Json?    @db.Json
  artist        Json?    @db.Json
  images        Json[]   @default([]) @db.Json
  genres        Json[]   @default([]) @db.Json
}

model Chapter {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  title      String?
  slug       String   @unique(map: "chapter_slug_idx")
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt
  updated_at DateTime @db.Timestamp(6)
  link       String
  numimages  Int      @default(0)
  has_images Boolean  @default(false)
  images     Json[]   @default([]) @db.Json
  comic      Json     @db.Json
}

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @default("NO_NAME")
  email         String     @unique(map: "user_email_idx")
  emailVerified DateTime?  @db.Timestamp(6)
  image         String?
  password      String?
  role          String     @default("user")
  address       Json?      @db.Json
  paymentMethod String?
  createdAt     DateTime   @default(now()) @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt
  account       Account[]
  Bookmark      Bookmark[]
  session       Session[]
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Bookmark {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String? @db.Uuid
  sessionBookmarkId String
  items             Json[]  @default([]) @db.Json
  user              User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Genre {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String? @unique(map: "zgenre_name_idx")
}

model Category {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique(map: "zcategory_name_idx")
}

model Author {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique(map: "zauthor_name_idx")
}

model Artist {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique(map: "zartist_name_idx")
}

model ComicImage {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  link     String
  image    String?
  status   String?
  checksum String?
  comic    String
}

model ChapterImage {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  link     String
  image    String?
  status   String?
  checksum String?
  comic    String
  chapter  String?
}
